{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "demo/**/*",
    "benchmark/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}