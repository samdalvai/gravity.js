{
  "name": "gravity.js",
  "version": "1.0.0",
  "description": "A game physics engine for the browser",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "targets": {
    "demo": {
      "distDir": "dist",
      "publicUrl": "./"
    }
  },
  "scripts": {
    "prestart": "npm run build:package",
    "start": "concurrently --kill-others-on-fail --names gravity,demo \"npm run watch:package\" \"npm run serve:demo\"",
    "prestart:package": "npm run build:package",
    "start:package": "npm run serve:demo",
    "watch:package": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "serve:demo": "parcel index.html --target demo",
    "clean": "rm -rf .parcel-cache & find dist -maxdepth 1 -type f -exec rm {} +",
    "benchmark": "rm -rf .benchmark-dist && tsc --outDir .benchmark-dist --rootDir . --module commonjs --target es2020 benchmark/index.ts && node .benchmark-dist/benchmark/index.js",
    "pretest": "npm run build:package",
    "test": "jest",
    "test:perf": "jest -- --runTestsByPath __tests__/Performance.test.ts --runInBand",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "build:package": "tsc --project tsconfig.build.json",
    "prebuild": "npm run build:package",
    "build": "parcel build index.html --target demo"
  },
  "author": "Samuel Dalvai",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@jest/globals": "^29.7.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.4",
    "eslint": "^8.45.0",
    "jest": "^29.7.0",
    "parcel": "^2.13.3",
    "typescript": "^5.7.2"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript"
    ]
  },
    "@parcel/resolver-default": {
    "packageExports": true
  }
}
